# Every variable in this file is required, in every environment, and none has a
# default (ADR 0008). Copy this file to .env and fill in the blanks: the settings
# refuse to import otherwise, naming every variable that is missing, empty or
# malformed in one exception.
#
#     cp .env.example .env
#
# The blank values below are the ones only you can supply. Everything else is a
# working value you can leave alone locally.

# --- Secrets and accounts: fill these in -------------------------------------

DJANGO_SECRET_KEY=
# Any string in local development. In production use a long random one and never
# reuse it between environments; it also signs JWTs.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary stores uploaded images, because the container filesystem is ephemeral.

KHALTI_SECRET_KEY=
# Called `live_secret_key` in both dashboards. Take it from test-admin.khalti.com
# for sandbox and admin.khalti.com for production -- the name does not distinguish
# them, the dashboard it came from does. Any placeholder will boot; only a real key
# will take a payment.

# --- Database ----------------------------------------------------------------

# Runtime connection. In production this is Supabase's pooler -- session mode on
# port 5432, transaction mode on 6543. The settings are written for either.
DATABASE_URL=postgres://user:password@localhost:5432/clothing_store

# Direct connection: migrations cannot run over the pooler at all, and the
# pre-deploy command runs `migrate --database=direct`. Locally this is the same URL
# as DATABASE_URL; in production it must differ.
DATABASE_DIRECT_URL=postgres://user:password@localhost:5432/clothing_store

REDIS_URL=redis://localhost:6379/0

# --- Django ------------------------------------------------------------------

# Read by Django before any settings module loads, so the value in .env is never
# honoured: locally the Makefile and manage.py choose `local`, and render.yaml sets
# `production` for both the build and the web process. Listed so the blueprint
# guard accepts it. See the exceptions in docs/convention.md.
DJANGO_SETTINGS_MODULE=config.settings.local

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# These two may be left empty: a deployment can legitimately trust no extra origins.
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Throttling --------------------------------------------------------------

# Per-endpoint scopes, separate from the global anonymous rate on purpose: browsing
# needs a high ceiling and the order-number lookup is an enumeration surface that
# needs a low one. Raising `anon` to help one would weaken the other.
# The period must be spelled out in full -- second, minute, hour or day.
DJANGO_THROTTLE_ANON=60/hour
DJANGO_THROTTLE_USER=1000/hour
DJANGO_THROTTLE_CATALOG=600/hour
DJANGO_THROTTLE_ORDER_LOOKUP=20/hour
DJANGO_THROTTLE_CHECKOUT=30/hour
DJANGO_THROTTLE_PAYMENT_RETURN=60/hour

# --- Email -------------------------------------------------------------------

# ADR 0006 sends transactional mail inside the request, which is why there is a
# timeout: an unresponsive SMTP host would otherwise hold a gunicorn worker open.
# Locally, django.core.mail.backends.console.EmailBackend prints instead of sending.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
# These two may be left empty: an SMTP relay may accept mail unauthenticated.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10

# --- Storefront --------------------------------------------------------------

# The storefront root, and the contract with the Next.js repository. Three things
# read it: Khalti receives it as `website_url`, the payment return redirects to
# {STOREFRONT_URL}/orders/<access_token>, and the confirmation email links to the
# same page. That storefront must serve /orders/<access_token> and /orders/failed.
# Must be https unless the host is localhost: that token is a bearer credential.
STOREFRONT_URL=https://example.com

# --- Shipping ----------------------------------------------------------------

# Flat courier rates, in rupees, by district band. A district matching neither is
# charged the outside rate. Stored on each order, so changing these never alters a
# historical total.
SHIPPING_FEE_INSIDE_VALLEY=150.00
SHIPPING_FEE_OUTSIDE_VALLEY=250.00

# --- Khalti (KPG-2) ----------------------------------------------------------

# Sandbox and live use different hosts as well as different keys, and a live key
# against the sandbox host fails in a way that looks like a credential problem.
KHALTI_BASE_URL=https://dev.khalti.com/api/v2/
# Where Khalti sends the customer's browser back to. Must be this API's own return
# endpoint, reachable from the public internet.
KHALTI_RETURN_URL=https://api.example.com/api/v1/payments/khalti/return/
KHALTI_TIMEOUT=10
