# --- Secrets and accounts: fill these in -------------------------------------
DJANGO_SECRET_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Database ----------------------------------------------------------------

# Runtime connection. In production this is Supabase's pooler -- session mode on
# port 5432, transaction mode on 6543. The settings are written for either.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/truelux

# Direct connection: migrations cannot run over the pooler at all, and the build
# runs `migrate --database=direct`. Locally this is the same URL as DATABASE_URL
# (docker compose publishes Postgres on 5433); in production it must differ.
DATABASE_DIRECT_URL=postgres://postgres:postgres@127.0.0.1:5433/truelux

# The schema every table lives in, on both connections. It must already exist:
# `migrate` does not create it. A lowercase identifier, e.g. public or truelux.
DATABASE_SCHEMA=public

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

DJANGO_CORS_ALLOWED_ORIGINS=https://localhost:3000,https:127.0.0.1:3000,https://localhost:3001,https://127.0.0.1:3001
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:3000,https:127.0.0.1:3000,https://localhost:3001,https://127.0.0.1:3001

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Throttling --------------------------------------------------------------
# The period must be spelled out in full -- second, minute, hour or day.
DJANGO_THROTTLE_ANON=60/hour
DJANGO_THROTTLE_USER=1000/hour
DJANGO_THROTTLE_CATALOG=600/hour
DJANGO_THROTTLE_ORDER_LOOKUP=20/hour
DJANGO_THROTTLE_CHECKOUT=30/hour
DJANGO_THROTTLE_QUOTE=600/hour
DJANGO_THROTTLE_AUTH=10/minute
DJANGO_THROTTLE_ADMIN=2000/hour

# --- Email -------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@truelux.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10

# --- Storefront --------------------------------------------------------------
STOREFRONT_URL=http://localhost:3000

# --- Demo staff login ----------------------------------------------------------
DEMO_STAFF_EMAIL=staff@truelux.com
DEMO_STAFF_PASSWORD=truelux-demo-staff

SEED_DEMO_DATA=false
